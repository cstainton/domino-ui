<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.dominokit</groupId>
        <artifactId>domino-ui-parent</artifactId>
        <version>2.1.0</version>
    </parent>

    <artifactId>domino-rest-teavm</artifactId>
    <packaging>jar</packaging>

    <name>domino-rest-teavm</name>
    <description>
        TeaVM port of domino-rest-client. Replaces elemental2 / GWT-specific dependencies with
        teavm-jso equivalents so that the REST client compiles to runnable browser JS via TeaVM.
        Activate -Pteavm to verify TeaVM-compatibility.
    </description>

    <properties>
        <domino.rest.version>2.0.0</domino.rest.version>
    </properties>

    <dependencies>
        <!-- Shared REST model: RestfulRequest, Response, ServerRequest, EventsBus, … -->
        <dependency>
            <groupId>org.dominokit</groupId>
            <artifactId>domino-rest-shared</artifactId>
            <version>${domino.rest.version}</version>
        </dependency>

        <!-- domino-jackson context for date-format configuration in DominoRestConfig -->
        <dependency>
            <groupId>org.dominokit</groupId>
            <artifactId>domino-jackson</artifactId>
            <version>${jackson.apt.version}</version>
        </dependency>

        <!-- TeaVM JSO core (@JSBody, JSObject, @JSProperty) -->
        <dependency>
            <groupId>org.teavm</groupId>
            <artifactId>teavm-jso</artifactId>
            <version>${teavm.version}</version>
        </dependency>

        <!-- TeaVM browser APIs (Window, Location, XMLHttpRequest, typed arrays, …) -->
        <dependency>
            <groupId>org.teavm</groupId>
            <artifactId>teavm-jso-apis</artifactId>
            <version>${teavm.version}</version>
        </dependency>

        <!-- SLF4J API for logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>1.7.30</version>
        </dependency>
    </dependencies>

    <profiles>
        <!--
            Activate with -Pteavm to verify that all sources compile cleanly against the TeaVM
            class library. This module is a library (no entry point), so teavm-maven-plugin is
            NOT invoked here — the downstream app module owns the compile step.
        -->
        <profile>
            <id>teavm</id>
        </profile>
    </profiles>
</project>
